<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="800.0" style="-fx-background-color: #313b63;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.passman.MainController">
    <children>
        <!-- Заголовок -->
        <Label alignment="CENTER" prefHeight="85.0" prefWidth="800.0" style="-fx-background-color: #2E3348;" text="PassMan — Мои пароли" textFill="WHITE">
            <font>
                <Font name="Cascadia Mono Regular" size="36.0" />
            </font>
        </Label>

        <!-- Панель управления (Кнопка + Поиск) -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #3d4975;">
            <children>
                <Button fx:id="addButton" mnemonicParsing="false" onAction="#openAddPassportView" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #4d5782; -fx-border-color: #5d6996; -fx-cursor: hand;" text="+ Добавить" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
                <Region prefWidth="200.0" HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefHeight="30.0" prefWidth="250.0" promptText="Поиск по названию..." style="-fx-background-color: #2E3348; -fx-text-fill: white;">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </TextField>
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </HBox>

        <!-- Основная таблица паролей -->
        <TableView fx:id="passwordTable" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #313b63;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitle" prefWidth="200.0" text="Сервис / Сайт" />
                <TableColumn fx:id="colLogin" prefWidth="200.0" text="Логин" />
                <TableColumn fx:id="colPass" prefWidth="200.0" text="Пароль" />
                <TableColumn fx:id="colURL" prefWidth="150.0" text="URL" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <VBox.margin>
                <Insets left="15.0" right="15.0" top="10.0" />
            </VBox.margin>
        </TableView>

        <!-- Быстрые действия с выделенной строкой -->
        <HBox alignment="CENTER" spacing="12.0">
            <children>
            <Button fx:id="redactButton" mnemonicParsing="false" onAction="#redactPass" prefHeight="25.0" prefWidth="119.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Редактировать" textFill="WHITE">
               <font>
                  <Font name="Cascadia Code Regular" size="12.0" />
               </font>
            </Button>
                <Button mnemonicParsing="false" onAction="#copyLogin" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Копировать логин" textFill="WHITE">
                    <font> <Font name="Cascadia Code Regular" size="12.0" /> </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#copyPass" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Копировать пароль" textFill="WHITE">
                    <font> <Font name="Cascadia Code Regular" size="12.0" /> </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#deleteEntry" style="-fx-background-color: #a33b3b; -fx-cursor: hand;" text="Удалить" textFill="WHITE">
                    <font> <Font name="Cascadia Code Regular" size="12.0" /> </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </HBox>

        <!-- Подвал -->
        <HBox alignment="BOTTOM_LEFT" prefHeight="50.0">
            <children>
                <Button fx:id="exitButton" cancelButton="true" mnemonicParsing="false" onAction="#exit" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Выход" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="settingsButton" cancelButton="true" mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Настройки" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </padding>
        </HBox>
    </children>
</VBox>
