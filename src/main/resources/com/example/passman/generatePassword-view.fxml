<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity" minHeight="353.0" minWidth="500.0" prefHeight="420.0" prefWidth="540.0" spacing="0.0" style="-fx-background-color: #313b63;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.passman.GeneratorController">

    <children>
        <!-- Шапка -->
        <Label alignment="CENTER" maxWidth="Infinity" prefHeight="70.0" style="-fx-background-color: #2E3348;" text="Генератор паролей" textFill="WHITE">
            <font>
                <Font name="Cascadia Mono Regular" size="28.0" />
            </font>
        </Label>

        <!-- Контент -->
        <VBox maxWidth="Infinity" prefHeight="224.0" prefWidth="540.0" spacing="14.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="18.0" />
            </padding>

            <children>
                <!-- Поле пароля -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #2E3348; -fx-background-radius: 6; -fx-padding: 8 12;">
                    <children>
                        <!-- Скрытое поле -->
                        <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS" prefHeight="25.0"
                                       style="-fx-background-color: #3d4975; -fx-text-fill: white; -fx-font-family: 'Cascadia Code', monospace;" />

                        <!-- Открытое текстовое поле -->
                        <TextField fx:id="visibleTextField" HBox.hgrow="ALWAYS" prefHeight="25.0" managed="false" visible="false"
                                   style="-fx-background-color: #3d4975; -fx-text-fill: white; -fx-font-family: 'Cascadia Code', monospace;" />

                        <!-- Кнопка Глаз -->
                        <Button fx:id="toggleEyeButton" onAction="#toggleVisibility"
                                style="-fx-background-color: #4d5782; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="👁" />

                        <!-- Кнопка Копировать -->
                        <Button onAction="#copyPassword"
                                style="-fx-background-color: #4d5782; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="📋" />
                    </children>
                </HBox>

                <!-- Индикатор надёжности -->
                <ProgressBar fx:id="qualityBar" maxWidth="Infinity" prefHeight="15.0" progress="0.0" style="-fx-accent: #4caf50;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <!-- Длина -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="Длина:" textFill="#b0b8d0">
                            <font>
                                <Font name="Cascadia Code Regular" size="13.0" />
                            </font>
                        </Label>
                        <Slider fx:id="lengthSlider" max="64" min="6" value="16" HBox.hgrow="ALWAYS" />
                        <Spinner fx:id="lengthSpinner" prefWidth="70.0" style="-fx-background-color: #2E3348;" />
                    </children>
                </HBox>

                <!-- Виды символов -->
                <VBox prefHeight="92.0" prefWidth="500.0" spacing="14.0">
                    <children>
                        <Label text="Использовать символы" textFill="#b0b8d0">
                            <font>
                                <Font name="Cascadia Code Regular" size="13.0" />
                            </font>
                        </Label>

                        <HBox prefHeight="0.0" prefWidth="500.0" spacing="8.0" style="-fx-background-color: #2E3348; -fx-padding: 12; -fx-background-radius: 6;">
                            <children>
                                <ToggleButton fx:id="btnUpper" maxWidth="Infinity" selected="true" styleClass="symbol-toggle-btn" text="A-Z" HBox.hgrow="ALWAYS" />
                                <ToggleButton fx:id="btnLower" maxWidth="Infinity" selected="true" styleClass="symbol-toggle-btn" text="a-z" HBox.hgrow="ALWAYS" />
                                <ToggleButton fx:id="btnDigits" maxWidth="Infinity" selected="true" styleClass="symbol-toggle-btn" text="0-9" HBox.hgrow="ALWAYS" />
                                <ToggleButton fx:id="btnSpecial" maxWidth="Infinity" selected="true" styleClass="symbol-toggle-btn" text="Спец. символы" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- Кнопка Генерировать по центру -->
        <HBox alignment="CENTER" maxWidth="Infinity" prefHeight="50.0" prefWidth="540.0">
            <children>
                <Button onAction="#generatePassword" prefHeight="30.0" prefWidth="160.0" style="-fx-background-color: #4d5782; -fx-text-fill: white; -fx-cursor: hand;" text="Генерировать">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <!-- Подвал -->
        <HBox alignment="CENTER_RIGHT" maxWidth="Infinity" prefHeight="63.0" prefWidth="540.0" spacing="12.0" style="-fx-background-color: #2E3348;">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Button fx:id="closeButton" onAction="#closeWindow" prefHeight="30.0" prefWidth="110.0" style="-fx-background-color: #a64646; -fx-text-fill: white; -fx-cursor: hand;" text="Закрыть">
                    <font>
                        <Font name="Cascadia Code Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="useButton" onAction="#usePassword" prefHeight="30.0" prefWidth="160.0" style="-fx-background-color: #52a646; -fx-text-fill: white; -fx-cursor: hand;" text="Использовать">
                    <font>
                        <Font name="Cascadia Code Regular" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
