<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity" minHeight="360.0" minWidth="450.0" spacing="0.0" style="-fx-background-color: #313b63;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.passman.AddPassController">

    <children>
        <!-- Шапка -->
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #2E3348;">
            <children>
                <Label text="Добавить запись" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="28.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
        </HBox>

        <!-- Форма -->
        <GridPane hgap="15.0" maxWidth="Infinity" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>

            <children>
                <Label text="Название:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font><Font name="Cascadia Code Regular" size="14.0" /></font>
                </Label>
                <TextField fx:id="titleField" maxWidth="Infinity" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Логин:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <TextField fx:id="loginField" maxWidth="Infinity" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Пароль:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <HBox maxWidth="Infinity" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <PasswordField fx:id="passwordField" maxWidth="Infinity" style="-fx-background-color: #3d4975; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                        <!-- Открытое текстовое поле -->
                        <TextField fx:id="visibleTextField" managed="false" prefHeight="25.0" style="-fx-background-color: #3d4975; -fx-text-fill: white; -fx-font-family: 'Cascadia Code', monospace;" visible="false" HBox.hgrow="ALWAYS" />

                        <!-- Кнопка Глаз -->
                        <Button fx:id="toggleEyeButton" onAction="#toggleVisibility" style="-fx-background-color: #4d5782; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="👁" />
                        <Button fx:id="generateButton" mnemonicParsing="false" onAction="#openGenerateWindow" prefHeight="26.0" prefWidth="93.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Генератор" textFill="WHITE" />
                    </children>
                </HBox>

                <Label text="Повтор:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <PasswordField fx:id="repeatField" maxWidth="Infinity" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Надежность:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <ProgressBar fx:id="qualityBar" maxWidth="Infinity" prefHeight="15.0" progress="0.0" style="-fx-accent: #4caf50;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Ссылка (URL):" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <TextField fx:id="urlField" maxWidth="Infinity" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="16.0" />
            </padding>
        </GridPane>

        <!-- Растягивается только когда окно больше нужного -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Кнопки -->
        <HBox alignment="CENTER_RIGHT" maxWidth="Infinity" spacing="15.0" style="-fx-background-color: #2E3348;">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancel" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #a64646; -fx-cursor: hand;" text="Отмена" textFill="WHITE">
                    <font><Font name="Cascadia Code Regular" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#addNewPassword" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #52a646; -fx-cursor: hand;" text="OK" textFill="WHITE">
                    <font><Font name="Cascadia Code Regular" size="14.0" /></font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
