<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="500.0" spacing="0.0" style="-fx-background-color: #313b63;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.passman.AddPassController">
    <children>
        <!-- Шапка окна (как на фото) -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2E3348;">
            <children>
                <VBox>
                    <children>
                        <Label text="Добавить запись" textFill="WHITE">
                            <font>
                                <Font name="Cascadia Code Regular" size="36.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>

        <!-- Основная форма ввода -->
        <GridPane hgap="15.0" prefHeight="241.0" prefWidth="500.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>

            <children>
                <!-- Название (Title) -->
                <Label text="Название:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font><Font name="Cascadia Code Regular" size="14.0" /></font>
                </Label>
                <TextField fx:id="titleField" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- Логин (User name) -->
                <Label text="Логин:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <TextField fx:id="loginField" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <!-- Пароль (Password) -->
                <Label text="Пароль:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <PasswordField fx:id="passwordField" style="-fx-background-color: #3d4975; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                        <Button fx:id="generateButton" mnemonicParsing="false" onAction="#generatePassword" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Генерировать" textFill="WHITE" />
                    </children>
                </HBox>

                <!-- Повтор пароля (Repeat) -->
                <Label text="Повтор:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <PasswordField fx:id="repeatField" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <!-- Качество пароля (Quality) -->
                <Label text="Надежность:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <ProgressBar fx:id="qualityBar" maxWidth="1.7976931348623157E308" prefHeight="15.0" progress="0.4" style="-fx-accent: #4caf50;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <!-- URL -->
                <Label text="Ссылка (URL):" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <font><Font name="Cascadia Code Regular" size="13.0" /></font>
                </Label>
                <TextField fx:id="urlField" style="-fx-background-color: #3d4975; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Подвал с кнопками -->
        <HBox alignment="CENTER_RIGHT" prefWidth="500.0" spacing="15.0" style="-fx-background-color: #2E3348;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#addNewPassword" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #52a646; -fx-cursor: hand;" text="OK" textFill="WHITE">
               <font>
                  <Font name="Cascadia Code Regular" size="14.0" />
               </font></Button>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancel" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #a64646; -fx-cursor: hand;" text="Отмена" textFill="WHITE">
               <font>
                  <Font name="Cascadia Code Regular" size="14.0" />
               </font></Button>
         </children>
        </HBox>
    </children>
</VBox>
