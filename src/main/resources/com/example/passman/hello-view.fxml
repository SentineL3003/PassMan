<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" maxHeight="Infinity" maxWidth="Infinity" minHeight="600.0" minWidth="500.0" prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: #313b63;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.passman.HelloController">

    <children>
        <!-- Заголовок -->
        <Label alignment="CENTER" maxWidth="Infinity" prefHeight="85.0" style="-fx-background-color: #2E3348;" text="PassMan" textFill="WHITE">
            <font>
                <Font name="Cascadia Mono Regular" size="36.0" />
            </font>
        </Label>

        <!-- Контейнер формы -->
        <VBox alignment="CENTER" maxWidth="Infinity" spacing="15.0" VBox.vgrow="NEVER">
            <VBox.margin>
                <Insets top="60.0" />
            </VBox.margin>
            <children>
                <Label text="Добро пожаловать в PassMan!" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="28.0" />
                    </font>
                </Label>

                <Label text="Создайте мастер-пароль для входа" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="18.0" />
                    </font>
                </Label>

                <PasswordField fx:id="masterField" maxWidth="300.0" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #4d5782; -fx-text-fill: #ffffff;">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </PasswordField>

                <Button fx:id="addMasterButton" disable="true" mnemonicParsing="false" onAction="#addMaster" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Принять" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>

        <!-- Растягивающийся промежуток — прижимает кнопку "Выход" вниз -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Нижняя панель -->
        <HBox alignment="BOTTOM_LEFT" maxWidth="Infinity" prefHeight="50.0">
            <children>
                <Button fx:id="exitButton" cancelButton="true" mnemonicParsing="false" onAction="#exit" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #4d5782; -fx-cursor: hand;" text="Выход" textFill="WHITE">
                    <font>
                        <Font name="Cascadia Code Regular" size="14.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </padding>
        </HBox>
    </children>
</VBox>
